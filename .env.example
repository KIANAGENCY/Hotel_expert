APP_URL=http://hotel_expert.test
APP_ENV=local
TRUST_PROXY_HEADERS=false

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hotel_expert
DB_USERNAME=root
DB_PASSWORD=

# Genera cada clave con: php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
PII_ENCRYPTION_KEY=
PII_BLIND_INDEX_KEY=

ADMIN_USERNAME=admin
# Obligatoria en la primera instalación. Usa una contraseña única de 16+ caracteres.
ADMIN_INITIAL_PASSWORD=

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_ENCRYPTION=tls
SMTP_FROM_EMAIL=ventas@hotelexpert.mx
SMTP_FROM_NAME=Hotel Expert

STRIPE_ENABLED=false
STRIPE_MODE=test
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_CURRENCY=mxn
